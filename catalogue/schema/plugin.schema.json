{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundworkers.example/schemas/plugin-catalogue-1.json",
  "title": "Groundworkers Plugin Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalogue", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "target_groundworkers", "target_python"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "target_groundworkers": {"type": "string", "minLength": 1},
        "target_python": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "plugins": {
      "type": "array",
      "items": {"$ref": "#/$defs/plugin"},
      "minItems": 1
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "summary", "visibility", "kind", "status", "capabilities",
        "repository", "distribution", "compatibility", "dependencies"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["public", "private"]},
        "kind": {"enum": ["host", "runtime-plugin", "prompt-pack", "filesystem-pack"]},
        "status": {"enum": ["planned", "released", "deprecated"]},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "slug", "access"],
          "properties": {
            "url": {"type": "string", "minLength": 1},
            "slug": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
            "access": {"enum": ["public", "private"]}
          }
        },
        "distribution": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["channel", "name", "version", "install"],
          "properties": {
            "channel": {"enum": ["pypi", "git", "filesystem"]},
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "install": {"type": "string", "minLength": 1}
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "groundworkers", "python", "test_profile", "matrix_enabled", "tested",
            "workflow", "workflow_file"
          ],
          "properties": {
            "groundworkers": {"type": ["string", "null"]},
            "python": {"type": ["string", "null"]},
            "test_profile": {
              "enum": ["host", "runtime-discovery", "prompt-pack-install", "filesystem-pack"]
            },
            "matrix_enabled": {"type": "boolean"},
            "tested": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["groundworkers", "python", "status"],
                "properties": {
                  "groundworkers": {"type": "string"},
                  "python": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                  "status": {"enum": ["planned", "pass", "fail", "unknown"]}
                }
              }
            },
            "workflow": {
              "type": ["string", "null"],
              "description": "Link to the component's Actions page, shown alongside its CI badge."
            },
            "workflow_file": {
              "type": ["string", "null"],
              "pattern": "^[^/]+\\.ya?ml$",
              "description": "Workflow filename used to build the live GitHub Actions badge."
            }
          }
        }
      }
    }
  }
}
